{
  "name": "kanaku-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:length": "node scripts/check-file-length.mjs",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "vitest run",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "realtime": "tsx --env-file=.env.local realtime/server.ts",
    "realtime:dev": "tsx watch --env-file=.env.local realtime/server.ts"
  },
  "dependencies": {
    "framer-motion": "^14.12.0",
    "mongodb": "^7.8.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
