# Copy to .env.local. Never commit real values.
SESSION_SECRET=replace-with-32+-random-bytes-hex
# Optional restriction: leave both empty to allow any email. Set to limit who can sign in / be invited.
ADMIN_EMAIL_DOMAINS=

# MongoDB (required). Use a dedicated database/user for the admin console.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB=kanaku_admin

# First Super Admin, created by `npm run seed` (forced password change + MFA setup at first sign-in).
SEED_ADMIN_EMAIL=admin@kanaku.com
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_PASSWORD=choose-a-strong-temporary-password

# Development only: echo reset/OTP codes in API responses while no email provider is connected. Ignored in production.
DEV_ECHO_CODES=false

# SMTP (invites, password reset, sign-in codes). Gmail: use an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kanaku <no-reply@example.com>"

# Public URL of the end-user app (used for links sent to users).
# Production URLs: admin https://admin-kanaku.vercel.app · user https://growwithkanaku-user.vercel.app · landing https://growwithkanaku.vercel.app (see docs/DEPLOYMENT.md)
USER_APP_URL=https://growwithkanaku-user.vercel.app

# Extra individual addresses allowed to sign in / be invited (comma separated), besides the domains above.
ADMIN_ALLOWED_EMAILS=
REALTIME_SECRET=
SERVICE_API_KEY=
REALTIME_PORT=4100
NEXT_PUBLIC_REALTIME_URL=http://localhost:4100
REALTIME_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
ADMIN_URL=http://localhost:3001
PUBLIC_API_ORIGINS=*
FIREBASE_SERVICE_ACCOUNT_JSON=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
LANDING_URL=
LANDING_REVALIDATE_SECRET=
